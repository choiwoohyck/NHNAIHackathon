      \uC9C4\uC220\uD568."
    keywords: []
  - id: TUT_A_ADMIT
    ownerSuspectId: A
    ownerSuspectName: "\uBC15 \uC8FC\uC784"
    text: "\uCD94\uAD81\uB2F9\uD558\uC790 \uBC15 \uC8FC\uC784\uC740 \uC5B4\uC82F\uBC24
      \uC790\uB8CC\uC2E4\uC5D0 \uB4E4\uC5B4\uAC14\uC74C\uC744 \uC778\uC815\uD568."
    keywords: []
  suspects:
  - id: A
    suspectName: "\uBC15 \uC8FC\uC784"
    occupation: "\uC790\uB8CC\uC2E4 \uB2F4\uB2F9"
    portrait: {fileID: 0}
    useCustomPortraitSize: 0
    portraitSize: {x: 400, y: 600}
    questions:
    - id: TUT_A_WHERE
      label: "\uC5B4\uC82F\uBC24 \uC5B4\uB514\uC5D0 \uC788\uC5C8\uC2B5\uB2C8\uAE4C?"
      kind: 0
      lines:
      - speaker: "\uC6D4\uD130"
        text: "\uC5B4\uC82F\uBC24 \uC790\uB8CC\uC2E4. \uADFC\uCC98\uC5D0 \uAC14\uC5C8\uB098?"
      - speaker: "\uBC15 \uC8FC\uC784"
        text: "\uC544\uB2C8\uC694. \uD1F4\uADFC\uD558\uACE0 \uACE7\uC7A5 \uC9D1\uC73C\uB85C
          \uAC14\uC2B5\uB2C8\uB2E4."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - TUT_A_ALIBI
      repeatable: 0
    - id: TUT_A_CONTRA
      label: "\uC790\uB8CC\uC2E4\uC5D0\uC11C \uB098\uC624\uB294 \uAC78 \uBCF8 \uC0AC\uB78C\uC774
        \uC788\uB294\uB370\uC694?"
      kind: 1
      lines:
      - speaker: "\uC6D4\uD130"
        text: "\uACE7\uC7A5 \uC9D1\uC73C\uB85C \uAC14\uB2E4\uACE0 \uD588\uC9C0. \uADF8\uB7F0\uB370
          \uC790\uB124\uAC00 \uC790\uB8CC\uC2E4\uC5D0\uC11C \uB098\uC624\uB294 \uAC78
          \uBCF8 \uC0AC\uB78C\uC774 \uC788\uC5B4."
      - speaker: "\uBC15 \uC8FC\uC784"
        text: "\u2026\uB450\uACE0 \uC628 \uAC8C \uC788\uC5B4\uC11C \uC7A0\uAE50 \uB4E4\uB800\uC2B5\uB2C8\uB2E4.
          \uB4E4\uC5B4\uAC04 \uAC74 \uB9DE\uC2B5\uB2C8\uB2E4."
      - speaker: "\uC6D4\uD130"
        text: "\uC7A0\uAE50\uC774\uB77C. \uADF8 \uC7A0\uAE50\uC744 \uC544\uC8FC \uC790\uC138\uD788
          \uB4E4\uC5B4\uBD10\uC57C\uACA0\uAD70."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds:
      - TUT_A_ALIBI
      - TUT_B_SAW
      grantTestimonyIds:
      - TUT_A_ADMIT
      repeatable: 0
  - id: B
    suspectName: "\uC774 \uC0AC\uC6D0"
    occupation: "\uC57C\uAC04 \uACBD\uBE44"
    portrait: {fileID: 0}
    useCustomPortraitSize: 0
    portraitSize: {x: 400, y: 600}
    questions:
    - id: TUT_B_NIGHT
