  caseId: TUTORIAL
  caseTitle: "\uD6C8\uB828 \uACFC\uC81C \xB7 \uC790\uB8CC\uC2E4 \uCE68\uC785"
  briefing: "\uD6C8\uB828\uC6A9 \uACFC\uC81C\uB2E4. \uC5B4\uC82F\uBC24 \uB204\uAD70\uAC00
    \uC790\uB8CC\uC2E4\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4.\n\uB450 \uC0AC\uB78C\uC5D0\uAC8C
    \uAC19\uC740 \uBC24\uC744 \uBB3B\uACE0, \uB9D0\uC774 \uC5B4\uAE0B\uB098\uB294
    \uC790\uB9AC\uB97C \uCC3E\uC544\uB77C."
  caseNumber: CASE-000
  caseImage: {fileID: 0}
  testimonies:
  - id: TUT_A_ALIBI
    ownerSuspectId: A
    ownerSuspectName: "\uBC15 \uC8FC\uC784"
    text: "\uBC15 \uC8FC\uC784\uC740 \uC5B4\uC82F\uBC24 \uC790\uB8CC\uC2E4 \uADFC\uCC98\uC5D0
      \uAC04 \uC801\uC774 \uC5C6\uB2E4\uACE0 \uC9C4\uC220\uD568."
    keywords: []
  - id: TUT_B_SAW
    ownerSuspectId: B
    ownerSuspectName: "\uC774 \uC0AC\uC6D0"
    text: "\uC774 \uC0AC\uC6D0\uC740 \uC5B4\uC82F\uBC24 \uBC15 \uC8FC\uC784\uC774
