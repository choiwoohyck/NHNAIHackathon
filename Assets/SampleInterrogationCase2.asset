%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d608b9d9a55a2646918144c0cc2dce0, type: 3}
  m_Name: SampleInterrogationCase2
  m_EditorClassIdentifier: Assembly-CSharp::InterrogationCase
  caseId: CASE_PENTHOUSE_MURDER
  caseTitle: "이재훈 대표 자택 살인 사건"
  briefing: "8월 3일 늦은 밤, OO상사 이재훈 대표가 자택 서재에서 목을 맨 채 숨진 상태로 발견되었다.\n처음엔 자살로 추정되었으나 부검 결과 사망 전 저항흔과 목 뒤쪽의 눌린 자국이 발견되어 타살 가능성이 제기되었다.\n피해자와 관계있는 용의자 3인을 취조하라."
  caseNumber: CASE-001
  caseImage: {fileID: 0}
  testimonies:
  - id: T_A_WHERE
    ownerSuspectId: A
    ownerSuspectName: "김도윤"
    text: "김도윤은 사건 당일 일찍 퇴근해 집에 있었다고 주장함."
    keywords:
    - "알리바이"
    - "귀가"
  - id: T_A_NOMONEY
    ownerSuspectId: A
    ownerSuspectName: "김도윤"
    text: "김도윤은 회사 자금 문제로 피해자와 갈등이 없었다고 부인함."
    keywords:
    - "자금"
    - "부인"
  - id: T_A_RELATION
    ownerSuspectId: A
    ownerSuspectName: "김도윤"
    text: "김도윤은 피해자와 가장 친한 동업자였으며 갈등이 없었다고 주장함."
    keywords:
    - "관계"
    - "동업자"
  - id: T_A_CONFESS_MONEY
    ownerSuspectId: A
    ownerSuspectName: "김도윤"
    text: "김도윤은 회삿돈 횡령 사실이 드러나 피해자와 크게 다퉜음을 인정함."
    keywords:
    - "번복"
    - "횡령"
  - id: T_A_CONFESS_WHERE
    ownerSuspectId: A
    ownerSuspectName: "김도윤"
    text: "김도윤은 사건 당일 밤 피해자의 자택에 들렀음을 인정함."
    keywords:
    - "번복"
    - "자택방문"
  - id: T_B_WHERE
    ownerSuspectId: B
    ownerSuspectName: "서혜인"
    text: "서혜인은 사건 당일 야근으로 사무실에 있었다고 진술함."
    keywords:
    - "알리바이"
    - "야근"
  - id: T_B_EMBEZZLE
    ownerSuspectId: B
    ownerSuspectName: "서혜인"
    text: "서혜인은 김도윤의 횡령 정황을 발견해 피해자에게 알렸고, 피해자가 크게 화를 냈다고 진술함."
    keywords:
    - "횡령"
    - "제보"
  - id: T_C_WHERE
    ownerSuspectId: C
    ownerSuspectName: "박성민"
    text: "박성민은 사건 당일 밤 피해자의 집 근처 카페에서 형을 기다리고 있었다고 진술함."
    keywords:
    - "알리바이"
    - "카페"
  - id: T_C_SAWCAR
    ownerSuspectId: C
    ownerSuspectName: "박성민"
    text: "박성민은 그날 밤 피해자의 집 근처에서 김도윤의 차를 봤다고 진술함."
    keywords:
    - "목격"
    - "차량"
  suspects:
  - id: A
    suspectName: "김도윤"
    occupation: "OO상사 부사장 겸 피해자의 동업자"
    questions:
    - id: A_WHERE
      label: "사건 당일 어디에 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당일 밤, 어디에 계셨습니까?"
      - speaker: "김도윤"
        text: "그날 저는 일찍 퇴근해서 집에 있었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_A_WHERE
      repeatable: 0
    - id: A_MONEY
      label: "회사 자금 문제로 피해자와 갈등이 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "최근 회사 자금 문제로 피해자와 다툰 적이 있습니까?"
      - speaker: "김도윤"
        text: "아니요, 그런 문제는 없었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_A_NOMONEY
      repeatable: 0
    - id: A_RELATION
      label: "피해자와는 어떤 관계였습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "피해자와는 평소 어떤 관계였습니까?"
      - speaker: "김도윤"
        text: "가장 친한 동업자였습니다. 갈등 같은 건 없었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_A_RELATION
      repeatable: 0
    - id: A_LIE_MONEY
      label: "비서의 증언에 따르면 당신의 횡령 사실이 드러나 피해자와 크게 다퉜다고 합니다."
      kind: 1
      lines:
      - speaker: "월터"
        text: "비서의 증언에 따르면, 당신이 회삿돈을 횡령한 정황이 드러나 피해자와 크게 다퉜다고 합니다."
      - speaker: "김도윤"
        text: "...맞습니다. 사실 횡령한 걸 들켜서 다퉜습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds:
      - T_A_NOMONEY
      - T_B_EMBEZZLE
      grantTestimonyIds:
      - T_A_CONFESS_MONEY
      repeatable: 0
    - id: A_LIE_WHERE
      label: "동생분의 증언에 따르면 그날 밤 피해자의 자택 근처에서 당신 차를 봤다고 합니다."
      kind: 1
      lines:
      - speaker: "월터"
        text: "피해자의 동생 증언에 따르면, 그날 밤 피해자의 자택 근처에 당신 차가 있었다고 합니다."
      - speaker: "김도윤"
        text: "...그날 밤 잠깐 들르긴 했습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds:
      - T_A_WHERE
      - T_C_SAWCAR
      grantTestimonyIds:
      - T_A_CONFESS_WHERE
      repeatable: 0
  - id: B
    suspectName: "서혜인"
    occupation: "피해자의 개인 비서"
    questions:
    - id: B_WHERE
      label: "사건 당일 어디에 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당일 밤, 어디에 계셨습니까?"
      - speaker: "서혜인"
        text: "저는 야근하느라 사무실에 있었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_WHERE
      repeatable: 0
    - id: B_KNOW
      label: "회사 자금과 관련해서 아는 것이 있습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "회사 자금과 관련해서 최근 알게 된 사실이 있습니까?"
      - speaker: "서혜인"
        text: "사실 최근 도윤 부사장님이 회삿돈을 개인적으로 쓰신 정황을 발견해서 대표님께 말씀드렸습니다. 대표님이 크게 화내셨어요."
      requiredQuestionIds:
      - B_WHERE
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_EMBEZZLE
      repeatable: 0
  - id: C
    suspectName: "박성민"
    occupation: "피해자의 친동생"
    questions:
    - id: C_WHERE
      label: "사건 당일 어디에 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당일 밤, 어디에 계셨습니까?"
      - speaker: "박성민"
        text: "저는 형 집 근처 카페에서 형을 기다리고 있었습니다. 유산 문제로 상의할 게 있어서요."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_C_WHERE
      repeatable: 0
    - id: C_SAW
      label: "그날 밤 특이한 점을 보셨습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "카페에서 기다리는 동안 특이한 점을 보셨습니까?"
      - speaker: "박성민"
        text: "형 집 근처에서 도윤 부사장님 차를 봤습니다. 이상하다고 생각했어요."
      requiredQuestionIds:
      - C_WHERE
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_C_SAWCAR
      repeatable: 0
  culpritSuspectId: A
  verdictTypoThreshold: 0.8
  minimumCorrectFields: 0
  verdictTemplate: "{범인}은(는) {동기} 때문에\n피해자를 {수단}(으)로 살해하고,\n이를 {위장}(으)로 꾸미려 했다."
  verdictFields:
  - label: "동기"
    prompt:
    answer: "횡령"
    options:
    - value: "횡령"
      synonyms:
      - "배임"
      - "자금횡령"
      - "돈"
  - label: "수단"
    prompt:
    answer: "질식사"
    options:
    - value: "질식사"
      synonyms:
      - "교살"
      - "목 조름"
      - "질식"
  - label: "위장"
    prompt:
    answer: "자살"
    options:
    - value: "자살"
      synonyms:
      - "극단적 선택"
      - "자결"
