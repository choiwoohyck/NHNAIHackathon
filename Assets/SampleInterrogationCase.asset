    - id: A_SECONDLIE
      label: "\uB2F9\uC2E0\uC740 \uCD5C\uACE0 \uB4F1\uAE09\uC758 \uBCF4\uC548 \uBB38\uC11C\uC5D0
        \uC811\uADFC\uC774 \uAC00\uB2A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C?"
      kind: 1
      lines:
      - speaker: "\uC6D4\uD130"
        text: "\uB2F9\uC2E0\uC740 \uCD5C\uACE0 \uB4F1\uAE09\uC758 \uBCF4\uC548 \uBB38\uC11C\uC5D0
