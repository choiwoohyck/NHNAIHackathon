%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d608b9d9a55a2646918144c0cc2dce0, type: 3}
  m_Name: SampleInterrogationCase
  m_EditorClassIdentifier: Assembly-CSharp::InterrogationCase
  caseId: CASE_NETWORK_INTRUSION
  caseTitle: "아슬라니아 국가 전산망 침입 사건"
  briefing: "7월 23일 오후 3시 20분, 국가 DB에 비인가 접근이 발생해 전산망이 약 3시간 동안 마비되었다.\n용의자 3인을 취조하라."
  caseNumber: CASE-000
  caseImage: {fileID: 0}
  testimonies:
  - id: T_A_WHERE
    ownerSuspectId: A
    ownerSuspectName: "클로버"
    text: "클로버는 사건 당일 회사에서 근무하고 있었다고 진술함."
    keywords:
    - "알리바이"
    - "근무"
  - id: T_A_COMPANY
    ownerSuspectId: A
    ownerSuspectName: "클로버"
    text: "클로버는 사건 당일 부서에 자신 혼자 있었다고 진술함(기억이 확실하지 않음)."
    keywords:
    - "부서"
    - "단독근무"
  - id: T_A_AUTH
    ownerSuspectId: A
    ownerSuspectName: "클로버"
    text: "클로버는 ASNET-B 등급까지 접근 가능하다고 진술함."
    keywords:
    - "권한"
    - "ASNET-B"
  - id: T_A_CONFESS_ABSENT
    ownerSuspectId: A
    ownerSuspectName: "클로버"
    text: "클로버는 사건 당일 출근하지 않았음을 인정함."
    keywords:
    - "번복"
    - "결근"
  - id: T_A_CONFESS_AUTH
    ownerSuspectId: A
    ownerSuspectName: "클로버"
    text: "클로버는 최고 등급 보안 문서 접근 권한에 대해 모른다며 얼버무림."
    keywords:
    - "번복"
    - "권한"
  - id: T_B_WHERE
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 사건 당일 회사에 있었다고 진술함."
    keywords:
    - "알리바이"
  - id: T_B_AUTH
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 보안 문서에 전혀 접근할 수 없다고 진술함."
    keywords:
    - "권한없음"
  - id: T_B_COMPANY
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 사건 당일 부서에 클레이튼 과장, 핸더슨 부장과 함께 있었으나 클레이튼 과장이 곧 출장을 떠나 자신과 핸더슨만 남았다고 진술함."
    keywords:
    - "부서"
    - "인원"
  - id: T_B_COMPANY2
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 클로버가 사건 당일 연차였다고 진술함."
    keywords:
    - "클로버"
    - "연차"
  - id: T_B_CLOVER
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 클로버가 근래 불안한 모습을 보였다고 진술함."
    keywords:
    - "클로버"
    - "불안"
  - id: T_B_CLOVER2
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 클로버가 책상 위 아버지 사진을 보며 눈물을 흘리는 모습을 목격했다고 진술함."
    keywords:
    - "클로버"
    - "아버지"
  - id: T_B_CLOVER3
    ownerSuspectId: B
    ownerSuspectName: "렉스"
    text: "렉스는 클로버의 아버지가 독립영웅이며, 독립 후 더 킹에 의해 숙청당했다는 소문을 들었다고 진술함."
    keywords:
    - "클로버"
    - "더킹"
    - "소문"
  - id: T_C_WHERE
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 사건 당일 회사에서 회의를 하고 있었다고 진술함."
    keywords:
    - "알리바이"
    - "회의"
  - id: T_C_AUTH
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 최고 등급까지 접근 가능하다고 진술함."
    keywords:
    - "권한"
    - "최고등급"
  - id: T_C_AUTH2
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 클레이튼 과장과 렉스가 자신의 알리바이를 증명해줄 것이라고 진술함."
    keywords:
    - "알리바이"
    - "증인"
  - id: T_C_AUTH3
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 최고 등급 권한을 가진 사람으로 클레이튼 과장과 클로버를 지목함."
    keywords:
    - "권한"
    - "클로버"
  - id: T_C_CLOVER
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 클로버가 과거 해커로 활동했다고 진술함."
    keywords:
    - "클로버"
    - "해커"
  - id: T_C_CLOVER2
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 클로버의 아버지가 더 킹에 의해 살해되었다고 진술함."
    keywords:
    - "클로버"
    - "더킹"
  - id: T_C_CLOVER3
    ownerSuspectId: C
    ownerSuspectName: "핸더슨"
    text: "핸더슨은 클로버에게 더 킹이 증오의 대상이었다고 진술함."
    keywords:
    - "클로버"
    - "증오"
  suspects:
  - id: A
    suspectName: "클로버"
    occupation: "정부기관 전산관리 부서 직원"
    portrait: {fileID: 21300000, guid: a45d395982d6d6243958ed703365e637, type: 3}
    useCustomPortraitSize: 0
    portraitSize: {x: 400, y: 500}
    questions:
    - id: A_WHERE
      label: "사건 당시 어디에 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당시 어디에 있었습니까?"
      - speaker: "클로버"
        text: "그날은 회사에서 근무하고 있었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_A_WHERE
      repeatable: 0
    - id: A_COMPANY
      label: "사건 당일 날 부서에 누가 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당일 날 부서에 누가 있었습니까?"
      - speaker: "클로버"
        text: "기억은 잘 안나지만 저 혼자였습니다."
      requiredQuestionIds:
      - A_WHERE
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_A_COMPANY
      repeatable: 0
    - id: A_AUTH
      label: "본인은 어디등급의 보안 데이터에 접근이 가능합니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "본인은 어디등급의 보안 데이터에 접근이 가능합니까?"
      - speaker: "클로버"
        text: "저는 ASNET-B 등급 데이터까지 접근이 가능합니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_A_AUTH
      repeatable: 0
    - id: A_FIRSTLIE
      label: "다른 동료의 증언에 따르면 그날 당신은 연차라고 했습니다."
      kind: 1
      lines:
      - speaker: "월터"
        text: "다른 동료의 증언에 따르면 그날 당신은 연차라고 했습니다."
      - speaker: "클로버"
        text: "제가 헷갈렸던 것 같습니다. 그날 출근하지 않은 것 맞습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds:
      - T_A_WHERE
      - T_B_COMPANY2
      grantTestimonyIds:
      - T_A_CONFESS_ABSENT
      repeatable: 0
    - id: A_SECONDLIE
      label: "당신은 최고 등급의 보안 문서에 접근이 가능하지 않습니까?"
      kind: 1
      lines:
      - speaker: "월터"
        text: "당신은 최고 등급의 보안 문서에 접근이 가능하지 않습니까?"
      - speaker: "클로버"
        text: "아 그랬습니까? 저는 잘 모릅니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds:
      - T_A_AUTH
      - T_C_AUTH3
      grantTestimonyIds:
      - T_A_CONFESS_AUTH
      repeatable: 0
  - id: B
    suspectName: "렉스"
    occupation: "전산관리 부서 동료"
    portrait: {fileID: 21300000, guid: ef9d4b9419cf96b498a774fc711db843, type: 3}
    useCustomPortraitSize: 0
    portraitSize: {x: 500, y: 633}
    questions:
    - id: B_WHERE
      label: "사건 당시 어디에 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당시 어디에 있었습니까?"
      - speaker: "렉스"
        text: "그날 저는 회사에 있었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_WHERE
      repeatable: 0
    - id: B_AUTH
      label: "본인은 어디등급의 보안 데이터에 접근이 가능합니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "본인은 어디등급의 보안 데이터에 접근이 가능합니까?"
      - speaker: "렉스"
        text: "저는 보안이 걸려있는 문서는 아무것도 접근할 수 없습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_AUTH
      repeatable: 0
    - id: B_COMPANY
      label: "사건 당일 날 부서에 누가 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당일 날 부서에 누가 있었습니까?"
      - speaker: "렉스"
        text: "그날은 클레이튼 과장과 핸더슨 부장이 회의를 진행하고 클레이튼 과장은 바로 출장을 나가 저랑 핸더슨 부장만 있었습니다."
      requiredQuestionIds:
      - B_WHERE
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_COMPANY
      repeatable: 0
    - id: B_COMPANY2
      label: "그날 클로버는 출근을 하지 않았습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "그날 클로버는 출근을 하지 않았습니까?"
      - speaker: "렉스"
        text: "제 기억에 클로버씨는 그날 연차였습니다."
      requiredQuestionIds:
      - B_COMPANY
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_COMPANY2
      repeatable: 0
    - id: B_CLOVER
      label: "평소 클로버는 어떤 사람이었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "평소 클로버는 어떤 사람이었습니까?"
      - speaker: "렉스"
        text: "아. 근래에 뭔가 불안한 모습을 많이 보였습니다."
      requiredQuestionIds:
      - A_FIRSTLIE
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_CLOVER
      repeatable: 0
    - id: B_CLOVER2
      label: "이상한 행동을 하진 않았습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "이상한 행동을 하진 않았습니까?"
      - speaker: "렉스"
        text: "책상의 있는 자신의 아버지 사진을 보며 눈물을 흘리곤 했습니다."
      requiredQuestionIds:
      - B_CLOVER
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_CLOVER2
      repeatable: 0
    - id: B_CLOVER3
      label: "클로버의 이야기를 알고있습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "클로버의 이야기를 알고있습니까?"
      - speaker: "렉스"
        text: "자세히는 모르지만 소문에 의하면 클로버씨의 아버지가 독립영웅인데, 독립 후 더킹에 의해 숙청당했다고 들었습니다."
      requiredQuestionIds:
      - B_CLOVER2
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_B_CLOVER3
      repeatable: 0
  - id: C
    suspectName: "핸더슨"
    occupation: "정부기관 보안 담당자"
    portrait: {fileID: 21300000, guid: 10e43910728ecbf44b3b2f89cdcc2abf, type: 3}
    useCustomPortraitSize: 0
    portraitSize: {x: 500, y: 633}
    questions:
    - id: C_WHERE
      label: "사건 당시 어디에 있었습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "사건 당시 어디에 있었습니까?"
      - speaker: "핸더슨"
        text: "회사에서 회의를 하고 있었습니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_C_WHERE
      repeatable: 0
    - id: C_AUTH
      label: "본인은 어디등급의 보안 데이터에 접근이 가능합니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "본인은 어디등급의 보안 데이터에 접근이 가능합니까?"
      - speaker: "핸더슨"
        text: "저는 최고 등급까지 접근이 가능합니다."
      requiredQuestionIds: []
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_C_AUTH
      repeatable: 0
    - id: C_AUTH2
      label: "회의를 하고 있었다는 증거가 있습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "회의를 하고 있었다는 증거가 있습니까?"
      - speaker: "핸더슨"
        text: "클레이튼 과장이나 렉스 사원에게 물어보면 제 알리바이를 증명해줄 겁니다."
      requiredQuestionIds:
      - C_AUTH
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_C_AUTH2
      repeatable: 0
    - id: C_AUTH3
      label: "그럼 해당 보안 등급을 가지고 있는 사람이 또 있습니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "그럼 해당 보안 등급을 가지고 있는 사람이 또 있습니까?"
      - speaker: "핸더슨"
        text: "클레이튼 과장과 클로버 사원입니다."
