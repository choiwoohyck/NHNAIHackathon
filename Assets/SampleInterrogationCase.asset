    - "\uC99D\uC778"
  - id: T_C_AUTH3
    ownerSuspectId: C
    ownerSuspectName: "\uD578\uB354\uC2A8"
    text: "\uD578\uB354\uC2A8\uC740 \uCD5C\uACE0 \uB4F1\uAE09 \uAD8C\uD55C\uC744
      \uAC00\uC9C4 \uC0AC\uB78C\uC73C\uB85C \uD074\uB808\uC774\uD2BC \uACFC\uC7A5\uACFC
