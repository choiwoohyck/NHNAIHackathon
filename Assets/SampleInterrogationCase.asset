    - "\uAD8C\uD55C"
  - id: T_B_WHERE
    ownerSuspectId: B
    ownerSuspectName: "\uB809\uC2A4"
    text: "\uB809\uC2A4\uB294 \uC0AC\uAC74 \uB2F9\uC77C \uD68C\uC0AC\uC5D0 \uC788\uC5C8\uB2E4\uACE0
