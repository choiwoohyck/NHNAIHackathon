    - id: A_FIRSTLIE
      label: "\uB2E4\uB978 \uB3D9\uB8CC\uC758 \uC99D\uC5B8\uC5D0 \uB530\uB974\uBA74
        \uADF8\uB0A0 \uB2F9\uC2E0\uC740 \uC5F0\uCC28\uB77C\uACE0 \uD588\uC2B5\uB2C8\uB2E4."
      kind: 1
      lines:
      - speaker: "\uC6D4\uD130"
        text: "\uB2E4\uB978 \uB3D9\uB8CC\uC758 \uC99D\uC5B8\uC5D0 \uB530\uB974\uBA74
          \uADF8\uB0A0 \uB2F9\uC2E0\uC740 \uC5F0\uCC28\uB77C\uACE0 \uD588\uC2B5\uB2C8\uB2E4."
      - speaker: "\uD074\uB85C\uBC84"
        text: "\uC81C\uAC00 \uD5F7\uAC08\uB838\uB358 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.
          \uADF8\uB0A0 \uCD9C\uADFC\uD558\uC9C0 \uC54A\uC740 \uAC83 \uB9DE\uC2B5\uB2C8\uB2E4."
