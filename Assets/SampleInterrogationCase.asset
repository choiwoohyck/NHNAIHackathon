    ownerSuspectId: A
    ownerSuspectName: "\uD074\uB85C\uBC84"
    text: "\uD074\uB85C\uBC84\uB294 \uC0AC\uAC74 \uB2F9\uC77C \uCD9C\uADFC\uD558\uC9C0
