    - id: C_CLOVER3
      label: "클로버에게 더 킹이란 어떤 사람입니까?"
      kind: 0
      lines:
      - speaker: "월터"
        text: "클로버에게 더 킹이란 어떤 사람입니까?"
      - speaker: "핸더슨"
        text: "증오의 대상이었습니다."
      requiredQuestionIds:
      - C_CLOVER2
      requiredTestimonyIds: []
      requireAll: 1
      requiredSelectedTestimonyIds: []
      grantTestimonyIds:
      - T_C_CLOVER3
      repeatable: 0
  culpritSuspectId: A
  verdictTypoThreshold: 0.8
  minimumCorrectFields: 0
  verdictTemplate: "{범인}은(는) {동기} 때문에\n{대상}을(를) 노려 {수단}(으)로\n국가 DB를 침입해, 전산망을 {목적}시키려 했다."
  verdictFields:
  - label: "동기"
    prompt:
    answer: "증오"
    options:
    - value: "증오"
      synonyms:
      - "반감"
      - "적대"
      - "혐오"
  - label: "대상"
    prompt:
    answer: "더 킹"
    options:
    - value: "더 킹"
      synonyms:
      - "국왕"
