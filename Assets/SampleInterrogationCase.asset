      repeatable: 0
    - id: A_COMPANY
      label: "\uC0AC\uAC74 \uB2F9\uC77C \uB0A0 \uBD80\uC11C\uC5D0 \uB204\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uAE4C?"
      kind: 0
      lines:
      - speaker: "\uC6D4\uD130"
        text: "\uC0AC\uAC74 \uB2F9\uC77C \uB0A0 \uBD80\uC11C\uC5D0 \uB204\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uAE4C?"
      - speaker: "\uD074\uB85C\uBC84"
        text: "\uAE30\uC5B5\uC740 \uC798 \uC548\uB098\uC9C0\uB9CC \uC800 \uD63C\uC790\uC600\uC2B5\uB2C8\uB2E4."
