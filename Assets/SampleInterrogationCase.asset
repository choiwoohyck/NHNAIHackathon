    - "\uADFC\uBB34"
  - id: T_A_COMPANY
    ownerSuspectId: A
    ownerSuspectName: "\uD074\uB85C\uBC84"
    text: "\uD074\uB85C\uBC84\uB294 \uC0AC\uAC74 \uB2F9\uC77C \uBD80\uC11C\uC5D0
