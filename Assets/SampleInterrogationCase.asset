    - id: A_AUTH
      label: "\uBCF8\uC778\uC740 \uC5B4\uB514\uB4F1\uAE09\uC758 \uBCF4\uC548 \uB370\uC774\uD130\uC5D0
        \uC811\uADFC\uC774 \uAC00\uB2A5\uD569\uB2C8\uAE4C?"
      kind: 0
      lines:
      - speaker: "\uC6D4\uD130"
        text: "\uBCF8\uC778\uC740 \uC5B4\uB514\uB4F1\uAE09\uC758 \uBCF4\uC548 \uB370\uC774\uD130\uC5D0
          \uC811\uADFC\uC774 \uAC00\uB2A5\uD569\uB2C8\uAE4C?"
      - speaker: "\uD074\uB85C\uBC84"
        text: "\uC800\uB294 ASNET-B \uB4F1\uAE09 \uB370\uC774\uD130\uAE4C\uC9C0 \uC811\uADFC\uC774
          \uAC00\uB2A5\uD569\uB2C8\uB2E4."
