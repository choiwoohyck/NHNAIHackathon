  - id: T_B_COMPANY
    ownerSuspectId: B
    ownerSuspectName: "\uB809\uC2A4"
    text: "\uB809\uC2A4\uB294 \uC0AC\uAC74 \uB2F9\uC77C \uBD80\uC11C\uC5D0 \uD074\uB808\uC774\uD2BC
