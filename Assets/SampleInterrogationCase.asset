    - "\uACB0\uADFC"
  - id: T_A_CONFESS_AUTH
    ownerSuspectId: A
    ownerSuspectName: "\uD074\uB85C\uBC84"
    text: "\uD074\uB85C\uBC84\uB294 \uCD5C\uACE0 \uB4F1\uAE09 \uBCF4\uC548 \uBB38\uC11C
